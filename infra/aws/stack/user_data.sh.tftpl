#!/bin/bash
# First boot of the diagnostic.ar instance (Amazon Linux 2023). Runs once, as
# root, through cloud-init; output in /var/log/cloud-init-output.log.
#
# Installs Docker, adds swap, installs /usr/local/bin/diagnosticar from the
# stack in S3, schedules the nightly dump, and deploys. Later changes to the
# stack are a `terraform apply` plus `scripts/remote.sh deploy`; this script
# does not run again.
set -euxo pipefail

mkdir -p /etc/diagnosticar /opt/diagnosticar
cat > /etc/diagnosticar/instance.env <<'ENV'
BUCKET=${bucket}
AWS_REGION=${region}
ENV

# --- Swap: a cushion for the extractor's peaks on a 2 GB instance ----------
if [ ! -f /swapfile ]; then
    dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
    chmod 600 /swapfile
    mkswap /swapfile
    echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi
swapon -a
# Prefer RAM; swap only under real pressure.
echo 'vm.swappiness=10' > /etc/sysctl.d/90-diagnosticar.conf
sysctl --system >/dev/null

# --- Docker + the compose plugin --------------------------------------------
dnf install -y docker
systemctl enable --now docker

# AL2023 does not package the compose plugin. Pinned, and checked against the
# release's own checksum.
COMPOSE_VERSION=v5.5.1
COMPOSE_SHA256=db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
    "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64"
echo "$COMPOSE_SHA256  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c
chmod 755 /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

# Container logs rotate instead of filling the disk.
cat > /etc/docker/daemon.json <<'JSON'
{ "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "3" } }
JSON
systemctl restart docker

# --- The deploy tool --------------------------------------------------------
aws s3 cp --region ${region} "s3://${bucket}/stack/diagnosticar.sh" /usr/local/bin/diagnosticar
chmod 755 /usr/local/bin/diagnosticar

# --- Nightly database dump to S3 --------------------------------------------
cat > /etc/systemd/system/diagnosticar-backup.service <<'UNIT'
[Unit]
Description=Dump the diagnostic.ar database to S3
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/diagnosticar backup
UNIT

cat > /etc/systemd/system/diagnosticar-backup.timer <<'UNIT'
[Unit]
Description=Nightly diagnostic.ar database dump

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now diagnosticar-backup.timer

# --- First deploy -------------------------------------------------------------
# Until push-images.sh has run, IMAGE_TAG is "none" and this only prepares the
# stack. A failure here must not mark the whole boot failed.
/usr/local/bin/diagnosticar deploy || echo "first deploy did not complete; run scripts/remote.sh deploy"
