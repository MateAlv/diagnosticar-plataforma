# =============================================================================
# diagnostic.ar — nodo0 (web node, behind Traefik)
# Copy to .env and fill in all values marked CHANGE_ME
# =============================================================================

# ── Public host routed by Traefik ─────────────────────────────────────────────
DIAGNOSTICAR_HOST=diagnosticar.infra.cluster.qb.fcen.uba.ar
TRAEFIK_NETWORK=internal-nodo0-web
TRAEFIK_CERT_RESOLVER=leresolver

# ── Service bind/ports on nodo0 host (keep localhost-only) ───────────────────
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=4000
DB_PORT=5432

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://${DIAGNOSTICAR_HOST}
BACKEND_URL=https://${DIAGNOSTICAR_HOST}
NODE_ENV=production

# ── Frontend build-time URLs (browser-visible) ───────────────────────────────
NEXT_PUBLIC_API_URL=https://${DIAGNOSTICAR_HOST}/api
NEXT_PUBLIC_API_BASE_URL=https://${DIAGNOSTICAR_HOST}/api
NEXT_PUBLIC_HPO_API_URL=https://${DIAGNOSTICAR_HOST}/hpo-api
NEXT_PUBLIC_GENPHENAI_URL=https://${DIAGNOSTICAR_HOST}/genphenai

# ── Frontend server-side proxy target (container-to-container) ───────────────
BACKEND_API_URL=http://backend:4000/api

# ── Auth (generate with: openssl rand -hex 32) ───────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars

# ── PostgreSQL (nodo0 local DB) ───────────────────────────────────────────────
POSTGRES_USER=diagnosticar
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=diagnosticar
DATABASE_URL=postgres://diagnosticar:CHANGE_ME_strong_password@db:5432/diagnosticar

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://${DIAGNOSTICAR_HOST}/api/auth/oauth/google/callback
GOOGLE_REDIRECT_URL=https://${DIAGNOSTICAR_HOST}/login

# ── SMTP (optional) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Gene profiles
# ---------------------------------------------------------------------------
# Path on the host to the gene description database, built by
# MateAlv/diagnostic.ar-gene-profiles and copied here with scp. Optional: the
# platform runs without it and simply shows genes with no description.
GENE_PROFILES_DB=./data/genes.db

# ---------------------------------------------------------------------------
# Follow-up question agent (optional)
# ---------------------------------------------------------------------------
# Internal service the backend calls to refine a ranking with a few yes/no
# questions. Empty URL = feature off. Locally, start it with
#   docker compose --profile question-agent up -d
# and set QUESTION_AGENT_URL=http://question-agent:8010.
QUESTION_AGENT_URL=
# Sent as X-Internal-Token. Required (32+ chars) in production when the URL is
# set. Generate with: openssl rand -hex 32
QUESTION_AGENT_TOKEN=
# The backend's hard limit per call. Keep it above the agent's worst case:
# queue wait (10 s) + QUESTION_AGENT_ROUND_BUDGET_S + its model-service
# timeout (10 s), 95 s by default, plus a margin; otherwise a round the agent finishes is thrown away here.
QUESTION_AGENT_TIMEOUT_MS=100000
# Seconds the agent may spend on one round; passed to it as
# PREGUNTAS_ROUND_BUDGET_S. Raise QUESTION_AGENT_TIMEOUT_MS with it.
QUESTION_AGENT_ROUND_BUDGET_S=75
# Spend caps. Only rounds sent to the agent count (not replays, rejected
# requests, or rounds the agent refused before starting), recorded in Postgres
# so a restart does not reset them. Positive integers; neither can be switched off.
# Rounds per account per hour:
QUESTION_AGENT_ROUNDS_PER_HOUR=20
# Rounds per rolling five hours across the whole deployment, every account
# together, since all of them spend the same Claude subscription:
QUESTION_AGENT_GLOBAL_ROUNDS_PER_5H=50
# Image tag for the question-agent service.
QUESTION_AGENT_TAG=latest

# The agent's own settings (PREGUNTAS_*), read only by the question-agent
# container. Its token is QUESTION_AGENT_TOKEN above, passed on as
# PREGUNTAS_SERVICE_TOKEN. Commented ones keep the agent's default.
# Where it ranks: the model's /rank-genes. The default reaches the host's 18020.
# PREGUNTAS_MODEL_SERVICE_URL=http://host.docker.internal:18020
# PREGUNTAS_MODEL_SERVICE_TIMEOUT_S=10
# claude-cli uses CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`);
# anthropic uses ANTHROPIC_API_KEY; template asks without any LLM.
PREGUNTAS_LLM_PROVIDER=claude-cli
PREGUNTAS_LLM_MODEL=claude-opus-5
# PREGUNTAS_LLM_TIMEOUT_S=60
# PREGUNTAS_LLM_EFFORT=high
# PREGUNTAS_LOG_LEVEL=INFO
# Also PREGUNTAS_MAX_CONCURRENT_ROUNDS: rounds the agent works on at once.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
