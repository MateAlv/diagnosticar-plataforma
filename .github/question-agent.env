# The commit of the question agent built into diagnosticar-question-agent by
# .github/workflows/release.yml, from a private repository reached with the
# read-only deploy key in the QUESTION_AGENT_DEPLOY_KEY secret. The Dockerfile
# is diagnostic.ar-api's services/question-agent/Dockerfile, at GATEWAY_COMMIT
# in recognizer.env.
#
# TODO: set QUESTION_AGENT_COMMIT to the full SHA of the agent commit to ship,
# once it is pushed, the QUESTION_AGENT_DEPLOY_KEY secret exists and
# GATEWAY_COMMIT names an API commit that has that Dockerfile. While it is
# empty the release skips the image instead of failing, so tagging a release is
# never blocked on it.
QUESTION_AGENT_REPO=MarBL00126/diagnosticar-question-agent
# 48d901e: the effective "no" answers go to the model as excluded_hpo_ids,
# for its re-ranker rr-v1 (MarBL00126/diagnosticar-question-agent PR #1,
# branch feat/rerank-negaciones, not yet merged by its owner).
QUESTION_AGENT_COMMIT=48d901e3a0197984c2811345c115c99f3e42d54c
