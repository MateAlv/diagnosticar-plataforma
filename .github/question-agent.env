# The commit of the question agent that release.yml builds into
# diagnosticar-question-agent, from a teammate's private repository read with
# the read-only deploy key in the QUESTION_AGENT_DEPLOY_KEY secret. The
# Dockerfile is diagnostic.ar-api's services/question-agent/Dockerfile, at
# GATEWAY_COMMIT in recognizer.env. Bump it to ship a new agent; the next
# release builds it, and a release that leaves it alone reuses the last build.
QUESTION_AGENT_REPO=MarBL00126/diagnosticar-question-agent
# aaf4607: feat/agente-v2 with PR #5 (merged into main by #4): the
# patient's sex, age and onset sent to the model with every round (D-20), on
# top of the Q2b selector (D-19) and the "no" answers as excluded_hpo_ids.
QUESTION_AGENT_COMMIT=aaf4607a1a80c266564eacbe0848995e15d994cb
