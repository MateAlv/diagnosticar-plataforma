{
  "name": "@lucai/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:lucai-css": "postcss styles/vendor/lucai/index.css -o public/vendor/lucai.scoped.css --config postcss.lucai.mjs",
