# Staging environment for nodo0. Copy to .env.staging and fill in.
# .env.staging is gitignored — it holds real secrets, just not production ones.

# --- Public identity -------------------------------------------------------
STAGING_HOST=staging.diagnosticar.infra.cluster.qb.fcen.uba.ar
TRAEFIK_NETWORK=internal-nodo0-web
TRAEFIK_CERT_RESOLVER=leresolver

# Keeps staging off the public internet and out of search indexes.
# Generate with:  htpasswd -nb equipo 'a-strong-password' | sed -e 's/\$/\$\$/g'
STAGING_BASIC_AUTH=equipo:$$apr1$$REPLACE$$ME

# The same password in plaintext, for ops/smoke.sh only — a hash cannot be used
# to authenticate a request. Leave it unset and every smoke check reads 401,
# because staging requires basic auth on every path including /health.
STAGING_SMOKE_PASSWORD=the-same-password-in-plaintext

# --- Database (staging only; synthetic data) -------------------------------
POSTGRES_USER=diagnosticar
POSTGRES_PASSWORD=CHANGE-ME-staging-only
POSTGRES_DB=diagnosticar
DATABASE_URL=postgresql://diagnosticar:CHANGE-ME-staging-only@db:5432/diagnosticar

# --- Secrets ---------------------------------------------------------------
# MUST differ from production. Generate with: openssl rand -hex 32
# Sharing them would let a staging session authenticate against production.
STAGING_JWT_ACCESS_SECRET=CHANGE-ME-32-chars-minimum-staging-access
STAGING_JWT_REFRESH_SECRET=CHANGE-ME-32-chars-minimum-staging-refresh
JWT_ACCESS_SECRET=${STAGING_JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${STAGING_JWT_REFRESH_SECRET}

# --- Model services on brainy ---------------------------------------------
# Staging shares the production tunnels; these are read-only inference calls.
NEXT_PUBLIC_HPO_API_URL=https://staging.diagnosticar.infra.cluster.qb.fcen.uba.ar/hpo-api
NEXT_PUBLIC_GENPHENAI_URL=https://staging.diagnosticar.infra.cluster.qb.fcen.uba.ar/genphenai
NEXT_PUBLIC_API_URL=https://staging.diagnosticar.infra.cluster.qb.fcen.uba.ar/api
NEXT_PUBLIC_API_BASE_URL=https://staging.diagnosticar.infra.cluster.qb.fcen.uba.ar/api
BACKEND_API_URL=http://backend:4000/api
FRONTEND_URL=https://staging.diagnosticar.infra.cluster.qb.fcen.uba.ar

# --- Email -----------------------------------------------------------------
# Leave SMTP unset on staging so no test run can email a real person.
NODE_ENV=production
